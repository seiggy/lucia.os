+/// One POST through the router over a socket pair; the reply's bytes (status line, headers, body).
+fn routed(srv: *Server, a: Allocator, path: []const u8, body: []const u8) ![]const u8 {
+    var fds: [2]std.c.fd_t = undefined;
+    if (std.c.socketpair(std.c.AF.UNIX, std.c.SOCK.STREAM, 0, &fds) != 0) return error.SocketPair;
+    defer _ = std.c.close(fds[1]);
+    var conn = try Conn.init(a, fds[0], "test");
+    defer {
+        conn.deinit();
+        _ = std.c.close(fds[0]);
+    }
+    if (std.c.write(fds[1], body.ptr, body.len) != @as(isize, @intCast(body.len))) return error.Write;
+    var headers = [_]@import("http_conn.zig").Header{.{ .name = "Content-Length", .value = try std.fmt.allocPrint(a, "{d}", .{body.len}) }};
+    conn.method = "POST";
+    conn.path = path;
+    conn.version = "HTTP/1.1";
+    conn.headers = &headers;
+    conn.close = false;
+    routes.dispatch(srv, &conn, a);
+    var out: std.ArrayList(u8) = .empty;
+    var buf: [4096]u8 = undefined;
+    _ = std.c.shutdown(fds[0], std.c.SHUT.WR);
+    while (true) {
+        const n = std.c.read(fds[1], &buf, buf.len);
+        if (n <= 0) break;
+        try out.appendSlice(a, buf[0..@intCast(n)]);
+    }
+    return out.items;
+}
