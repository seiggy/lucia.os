+//! Decisions' label scores on CUDA: the prompt's last logits row (bf16, kept on the host by cuda_lanes' keepFirstRow)
+//! read at the labels, and the row's logsumexp in f64. Host arithmetic only: no kernel, no device work.
+const std = @import("std");
+
+/// One logit per label from `row` (bf16 [vocabulary], widened), and its logsumexp in f64 when `mass` (else 0).
+pub fn labels(row: []const u8, wanted: []const u32, logits: []f64, mass: bool) !f64 {
+    if (row.len == 0 or row.len % 2 != 0) return error.BadFirstRow;
+    if (wanted.len == 0 or wanted.len != logits.len) return error.UnexpectedTensor;
+    const r = std.mem.bytesAsSlice(u16, row);
+    for (wanted) |t| if (t >= r.len) return error.LabelOutsideVocabulary;
+    for (wanted, logits) |t, *v| {
+        v.* = widen(std.mem.littleToNative(u16, r[t]));
+        if (!std.math.isFinite(v.*)) return error.NonFiniteScore;
+    }
+    return if (mass) logsumexp(r) else 0;
+}
+
+/// A bf16 value as f64 (exact: bf16 is f32's top half).
+fn widen(b: u16) f64 {
+    return @as(f32, @bitCast(@as(u32, b) << 16));
+}
+
+/// The bf16 row's logsumexp in f64; a non-finite row is refused.
+fn logsumexp(row: []align(1) const u16) !f64 {
+    var top: f64 = -std.math.inf(f64);
+    for (row) |b| {
+        const v = widen(std.mem.littleToNative(u16, b));
+        if (!std.math.isFinite(v)) return error.NonFiniteScore;
+        top = @max(top, v);
+    }
+    var sum: f64 = 0;
+    for (row) |b| sum += @exp(widen(std.mem.littleToNative(u16, b)) - top);
+    return top + @log(sum);
+}
+
+test "the logsumexp of a bf16 row in f64, and a non-finite row refused" {
+    const one: u16 = 0x3f80; // 1.0
+    const two: u16 = 0x4000; // 2.0
+    const row = [_]u16{ one, two, one };
+    const want = 2.0 + @log(1.0 + 2.0 * @exp(@as(f64, -1.0)));
+    try std.testing.expectApproxEqRel(want, try logsumexp(&row), 1e-15);
+    try std.testing.expectError(error.NonFiniteScore, logsumexp(&[_]u16{ one, 0x7f80 }));
+}
+
+test "labels read the kept row's bf16 logits; labels past the row and a non-finite label are refused" {
+    const row = [_]u16{ 0x3f80, 0xc000, 0x4040, 0x7fc0 }; // 1, -2, 3, NaN
+    const bytes = std.mem.sliceAsBytes(&row);
+    var logits: [2]f64 = undefined;
+    try std.testing.expectEqual(@as(f64, 0), try labels(bytes, &.{ 2, 1 }, &logits, false));
+    try std.testing.expectEqualSlices(f64, &.{ 3, -2 }, &logits);
+    try std.testing.expectError(error.NonFiniteScore, labels(bytes, &.{ 0, 1 }, &logits, true)); // the row's NaN
+    try std.testing.expectError(error.NonFiniteScore, labels(bytes, &.{ 3, 1 }, &logits, false));
+    try std.testing.expectError(error.LabelOutsideVocabulary, labels(bytes, &.{ 4, 1 }, &logits, false));
+    try std.testing.expectError(error.UnexpectedTensor, labels(bytes, &.{1}, &logits, false));
+    const finite = std.mem.sliceAsBytes(row[0..3]);
+    const mass = try labels(finite, &.{ 0, 2 }, &logits, true);
+    try std.testing.expectApproxEqRel(3.0 + @log(@exp(@as(f64, -2.0)) + @exp(@as(f64, -5.0)) + 1.0), mass, 1e-15);
+}
