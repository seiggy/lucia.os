<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>Lucia.SkillSandbox</AssemblyName>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Lucia.SkillSandbox.Checks" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.Hyperlight" Version="1.23.0-preview.260928.1" />
    <PackageReference Include="Hyperlight.HyperlightSandbox.Guest.Python" Version="0.7.0" />
    <PackageReference Include="Hyperlight.HyperlightSandbox.Guest.JavaScript" Version="0.7.0" />
  </ItemGroup>
</Project>
