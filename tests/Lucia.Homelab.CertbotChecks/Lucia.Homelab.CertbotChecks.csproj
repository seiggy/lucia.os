<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Source linking keeps these checks GPU-free and the fake executor/test trust roots internal. -->
    <Compile Include="..\..\src\Lucia.Homelab.Server\Domains\Certbot*.cs" Link="Domains\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
