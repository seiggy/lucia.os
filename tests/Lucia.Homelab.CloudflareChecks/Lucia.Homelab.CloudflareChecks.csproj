<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Compile Include="..\..\src\Lucia.Homelab.Server\Domains\Cloudflare*.cs" Link="Domains\%(Filename)%(Extension)" />
    <!-- Reuse the server's already-restored telemetry assemblies without its GPU/native dependencies. -->
    <Reference Include="OpenTelemetry.Api">
      <HintPath>$(NuGetPackageRoot)opentelemetry.api\1.15.3\lib\net10.0\OpenTelemetry.Api.dll</HintPath>
    </Reference>
    <Reference Include="OpenTelemetry">
      <HintPath>$(NuGetPackageRoot)opentelemetry\1.15.3\lib\net10.0\OpenTelemetry.dll</HintPath>
    </Reference>
    <Reference Include="OpenTelemetry.Api.ProviderBuilderExtensions">
      <HintPath>$(NuGetPackageRoot)opentelemetry.api.providerbuilderextensions\1.15.3\lib\net10.0\OpenTelemetry.Api.ProviderBuilderExtensions.dll</HintPath>
    </Reference>
    <Reference Include="OpenTelemetry.Instrumentation.AspNetCore">
      <HintPath>$(NuGetPackageRoot)opentelemetry.instrumentation.aspnetcore\1.15.2\lib\net10.0\OpenTelemetry.Instrumentation.AspNetCore.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
