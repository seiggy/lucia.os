# Lucia's changes to the image's config.yaml; CrowdSec merges this file over it at every start.
crowdsec_service:
  acquisition_path: /lucia/config/acquis.yaml
api:
  server:
    profiles_path: /lucia/config/profiles.yaml
db_config:
  flush:
    # Ban escalation (profiles.yaml) counts an address's decisions from the last 30 days.
    max_age: 30d
prometheus:
  enabled: true
  level: aggregated
  listen_addr: 0.0.0.0
  listen_port: 6060
