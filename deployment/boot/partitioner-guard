#!/bin/sh
# Read-only images never contain installation-enabled. Install images still
# require a current, exact-disk grant before the partitioner may proceed.
trap '' HUP INT TERM
if [ -f /etc/lucia/installation-enabled ] && [ -r /etc/lucia/discovery.conf ]; then
    . /etc/lucia/discovery.conf
    set -- installation-guard --server "$LUCIA_SERVER" --ca-file /etc/lucia/public-ca.crt --state-directory /run/lucia
    if [ -n "$LUCIA_CONNECT_ADDRESS" ]; then
        set -- "$@" --connect-address "$LUCIA_CONNECT_ADDRESS"
    fi
    if /usr/lib/lucia/agent/ld-linux-x86-64.so.2 --inhibit-cache --library-path /usr/lib/lucia/agent \
        /usr/lib/lucia/agent/lucia-node-agent "$@"; then
        # partman matches disks by kernel name, and mapdevfs passes NVMe/virtio by-id links through
        # unchanged, so hand partman and grub the device behind the approved, just-verified by-id path.
        . /usr/share/debconf/confmodule
        # The guard runs as partman's early_command and init.d hook; keep the approved by-id path from the first run.
        approved=/run/lucia/approved-disk-id
        if [ ! -s "$approved" ]; then
            db_get partman-auto/disk
            printf '%s\n' "$RET" > "$approved"
        fi
        read -r id < "$approved"
        disk="$(readlink -f "$id")"
        case "$id:$disk" in
            /dev/disk/by-id/*:/dev/[a-z]*)
                if [ -b "$disk" ] && [ "${disk#/dev/*/}" = "$disk" ]; then
                    db_set partman-auto/disk "$disk"
                    db_set grub-installer/bootdev "$disk"
                    exit 0
                fi ;;
        esac
        echo "Lucia could not resolve the approved disk. Partitioning is blocked." >&2
    else
        echo "Lucia installation authorization failed. Partitioning is blocked." >&2
    fi
fi
echo "Lucia read-only discovery bundle: partitioning is permanently disabled." >&2
while :; do sleep 3600; done
