#!/bin/sh
set -eu
umask 077
[ -f /etc/lucia/installation-enabled ]
. /etc/lucia/discovery.conf
set -- stage-managed --server "$LUCIA_SERVER" --ca-file /etc/lucia/public-ca.crt --state-directory /run/lucia
if [ -n "$LUCIA_CONNECT_ADDRESS" ]; then
    set -- "$@" --connect-address "$LUCIA_CONNECT_ADDRESS"
fi
agent=/usr/lib/lucia/agent
if "$agent/ld-linux-x86-64.so.2" --inhibit-cache --library-path "$agent" "$agent/lucia-node-agent" "$@" 2>/run/lucia/finish.err; then
    cat /run/lucia/finish.err >&2
    exit 0
fi
# The installer only shows "exit code 1"; show the agent's reason on the Lucia screen.
if [ -r /usr/lib/lucia/screen.sh ]; then
    . /usr/lib/lucia/screen.sh
    screen_open
    s1=ok s2=ok s3=ok s4=ok s5=fail d4=installed PANEL=fail
    FAIL_WHAT='this machine could not join Lucia'
    FAIL_TODO='Check it in Lucia → Devices, then network-boot it again.'
    FAIL_DETAIL=$(sed '/^$/d' /run/lucia/finish.err 2>/dev/null | tail -n 1)
    FAIL_NOTE='Debian is installed but not managed. Reinstalling replaces it.'
    screen_draw
    screen_front
fi
cat /run/lucia/finish.err >&2
exit 1
