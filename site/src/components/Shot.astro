---
import { u } from '../lib/url';

interface Props {
  name: string;
  route: string;
  alt: string;
  captured?: string;
  class?: string;
  eager?: boolean;
}
const { name, route, alt, captured = '2026-10-07', class: cls, eager = false } = Astro.props;
---
<figure class:list={['shot', cls]}>
  <div class="bezel">
    <img src={u(`/screenshots/${name}.png`)} width="1440" height="900" alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  </div>
  <figcaption class="plate">
    <span><span class="engr">Captured</span> lucia.homelab.seiggy.com/{route}</span>
    <span><span class="engr">On</span> {captured}</span>
    <span class="engr">Unretouched</span>
  </figcaption>
</figure>

<style>
  .shot { margin: 0; }
  .bezel {
    padding: 10px; border-radius: 12px;
    background: linear-gradient(180deg, #1f2126, #121316);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06), 0 0 0 1px var(--rule-2), 0 24px 48px rgb(0 0 0 / 0.55);
  }
  .bezel img { width: 100%; height: auto; border-radius: 4px; box-shadow: 0 0 0 1px #000; }
  .plate {
    display: flex; flex-wrap: wrap; gap: 6px 22px; margin-top: 10px; padding: 0 4px;
    font: 400 0.8125rem/1.4 var(--body); color: var(--ink-2);
  }
  .plate .engr { font-size: 0.6875rem; margin-right: 6px; }
  .plate > .engr:last-child { margin-left: auto; color: #c47a2c; margin-right: 0; }
</style>
